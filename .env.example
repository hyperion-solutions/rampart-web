# Wise Old Man group id (the number in wiseoldman.net/groups/<id>)
WOM_GROUP_ID=25534
WOM_API_BASE_URL=https://api.wiseoldman.net/v2
WOM_USER_AGENT=rampart-web (Discord: rampart)

# Postgres (Neon). Set automatically on Vercel by the Neon integration.
# Locally, pull them with: npx vercel env pull .env.development.local
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Discord sign-in (Auth.js). Set in Vercel for all environments.
# AUTH_SECRET: generate with `openssl rand -base64 33`; use the same value in Production and Preview.
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Preview only: lets preview deploys sign in through production's registered Discord redirect.
# AUTH_REDIRECT_PROXY_URL=https://rampart-web-alpha.vercel.app/api/auth
